{
  "service_name": "ilx_craneiq_core",
  "pipeline": {
    "server": "127.0.0.1",
    "port": 7000,
    "connection_timeout_s": 5,
    "max_queue_size": 10,
    "reconnect_interval_ms": 100
  },
  "services": {
    "modbus": {
      "service_name": "modbus_service",
      "groups": []
    },
    "loadcell": {
      "service_name": "load_cell_service",
      "datapoint_name": "load",
      "unit_datapoint_name": "capacity"
    },
    "emergency_output": {
      "service_name": "gpio_service",
      "datapoint_name": "Hoist_power"
    }
  },
  "logging": {
    "level": "info"
  }
}